{
  "manifest_version": 3,
  "name": "Clikk",
  "version": "0.7.0",
  "description": "Checks links for safety before you visit them — on-device AI plus URLhaus, OpenPhish and ThreatFox blocklists. Private by design.",
  "permissions": ["storage", "scripting", "tabs", "webNavigation", "alarms"],
  "host_permissions": [
    "<all_urls>",
    "https://www.virustotal.com/*",
    "https://urlhaus.abuse.ch/*",
    "https://openphish.com/*",
    "https://threatfox-api.abuse.ch/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Clikk",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
